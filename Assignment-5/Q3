clc; clear; close all;

% Define x range
x = linspace(0, 40, 400);

y1 = (90 - 4.*x)/7;
y2 = (120 - 5.*x)/4;

% Intersection point calculation (A*X = B)
A = [4 7; 5 4];
B = [90; 120];
inter = A\B;

x_int = (90*4 - 120*7) / (4*4 - 5*7); % x = 25.26
y_int = (90 - 4*x_int) / 7;          % y = -1.57 

points = [0, 30;    
          24, 0]; 

figure;
plot(x, y1, 'r', 'LineWidth', 2); hold on;
plot(x, y2, 'b', 'LineWidth', 2);

% Shading the Feasible Region (Minimization is the outer area)
x_fill = [0 0 24 40 40];
y_fill = [40 30 0 0 40];
fill(x_fill, y_fill, 'g', 'FaceAlpha', 0.2);

% Plot Corner Points
plot(points(:,1), points(:,2), 'ko', 'MarkerFaceColor', 'k');

xlabel('Food 1 (x kg)');
ylabel('Food 2 (y kg)');
title('Diet Problem - Minimization Feasible Region');
legend('4x+7y=90','5x+4y=120','Corner Points','Feasible Region');
grid on;
axis([0 35 0 35]);

% Cost calculation
Z = 5*points(:,1) + 6*points(:,2);
[min_cost, idx] = min(Z);

fprintf('Corner Points and their Costs:\n');
disp(table(points(:,1), points(:,2), Z, 'VariableNames', {'X', 'Y', 'Cost'}));
fprintf('Minimum Cost is Tk. %.2f at x = %.2f, y = %.2f\n', min_cost, points(idx,1), points(idx,2));
