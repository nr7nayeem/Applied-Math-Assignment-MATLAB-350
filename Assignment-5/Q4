%north-west corner method
clc; clear;

C = [3 5 7 6;
     2 5 8 2;
     3 6 9 2];

supply = [50; 75; 25];
demand = [20 20 50 60];

m=3;n=4;% size of matrix row by column
X = zeros(3,4);

i = 1; j = 1;

while i<=m && j<=n
    x = min(supply(i), demand(j));
    X(i,j) = x;
    
    supply(i) = supply(i) - x;
    demand(j) = demand(j) - x;
    
    if supply(i) == 0
        i = i + 1;
    elseif demand(j) == 0
        j = j + 1;
    end
end
total_cost = sum(sum(C .* X));

disp('Total Cost:');
disp(total_cost)
disp('NW Corner Solution:');
disp(X)
