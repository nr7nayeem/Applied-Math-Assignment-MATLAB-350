% Data
h = [0 3 6 9 12 15 18 21 24 27 30 33]; % height in km
D = [1.2 0.91 0.66 0.47 0.31 0.19 0.12 0.075 0.046 0.029 0.018 0.011]; % density in kg/m3

% (i) Linear-Linear plot
figure;
subplot(2,2,1);
plot(h, D, 'o','MarkerSize',6,'LineWidth',1.5);
xlabel('Height h (km)');
ylabel('Density D (kg/m^3)');
title('Linear-Linear plot');
grid on;

% (ii) Log h - Linear D plot
subplot(2,2,2);
semilogx(h, D, 'o','MarkerSize',6,'LineWidth',1.5);
xlabel('Height h (km) [log scale]');
ylabel('Density D (kg/m^3)');
title('Log-Linear plot');
grid on;

% (iii) Linear h - Log D plot
subplot(2,2,3);
semilogy(h, D, 'o','MarkerSize',6,'LineWidth',1.5);
xlabel('Height h (km)');
ylabel('Density D (kg/m^3) [log scale]');
title('Linear-Log plot');
grid on;

% (iv) Log-Log plot
subplot(2,2,4);
loglog(h, D, 'o','MarkerSize',6,'LineWidth',1.5);
xlabel('Height h (km) [log scale]');
ylabel('Density D (kg/m^3) [log scale]');
title('Log-Log plot');
grid on;

%
Y=log(D);
p=polyfit(h,Y,1);
a=p(1);
b=p(2);
y=exp(b)*exp(a*h);
plot(h,y,'-b','linewidth',2);
















