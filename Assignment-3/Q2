clc;
clear;
syms v(x)

K = 30;
m = 1500;
v0 = 25;     

ode = diff(v,x) == - (K/m) * v^2 * (x+1)^3;

cond = v(0) == v0;

vsol = dsolve(ode, cond);

x=linspace(0,3,100);
f=matlabFunction(vsol);
y=f(x);

plot(x, y, 'LineWidth',2)
grid on
xlabel('Displacement x (m)')
ylabel('Velocity v (m/s)')
title('Velocity vs Position (Direct Solution)')
legend('v(x)')
