%%iii
clc; clear; close all;

[x,y] = meshgrid(linspace(0,3,200));
R = (x.*y >= 1);

contourf(x,y,R,5)
axis equal
hold on

% Two valid points
A = [1,1];
B = [1.9,0.5];

% Line
t = linspace(0,1,100);
X = t*A(1) + (1-t)*B(1);
Y = t*A(2) + (1-t)*B(2);
%point er graph
plot(A(1),A(2),'ro','LineWidth',2)
plot(B(1),B(2),'ro','LineWidth',2)
%line er graph
plot(X,Y,'k','LineWidth',2)

title('(iii) Not Convex: Line goes outside')

%%iv-------------------------------------
clc; clear; close all;

[x,y] = meshgrid(linspace(-2,2,200));
R = (x.^2+y.^2 <= 1);

contourf(x,y,R)
axis equal
hold on

% Two valid points
A = [0.33,0.89];
B = [0.93,-0.37];

% Line
t = linspace(0,1,100);
X = t*A(1) + (1-t)*B(1);
Y = t*A(2) + (1-t)*B(2);
%point er graph
plot(A(1),A(2),'ro','LineWidth',2)
plot(B(1),B(2),'ro','LineWidth',2)
%line er graph
plot(X,Y,'k','LineWidth',2)
%% iii------------------------------
title('(iii) Not Convex: Line goes outside')
clc; clear; close all;

% Define region
[x,y,z] = meshgrid(linspace(-2,2,30));
R = (2*x - y + 3*z <= 2);
% Plot 3D region
figure
isosurface(x,y,z,R,0.5)
hold on

% Two points in 3D
A = [-1.44 0.27 1.72];
B = [0.7 -2 -0.4];

% Line segment
t = linspace(0,1,100);
X = (1-t)*A(1) + t*B(1);
Y = (1-t)*A(2) + t*B(2);
Z = (1-t)*A(3) + t*B(3);

% Plot line
plot3(X,Y,Z,'k','LineWidth',2)

% Points
plot3(A(1),A(2),A(3),'ro')
plot3(B(1),B(2),B(3),'ro')

xlabel('X'), ylabel('Y'), zlabel('Z')
title('3D Line Segment Convexity Test')
axis equal
grid on
