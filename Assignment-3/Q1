clc;
clear;
close all;

v0 = 250;         
theta = 65;        
g = 9.81;         

x0 = 3000;         
y0 = 0;           
z0 = 0;          

wind = -30;        

v0y = v0*cosd(theta);  
v0z = v0*sind(theta);  

% Time 
T = 2*v0z/g;

t = linspace(0, T, 500);

x_wind = x0 + wind*t;
y_wind = y0 + v0y*t;
z_wind = z0 + v0z*t - 0.5*g*t.^2;

% Without Wind 
x_nowind = x0 + 0*t;
y_nowind = y0 + v0y*t;
z_nowind = z0 + v0z*t - 0.5*g*t.^2;

figure
plot3(x_wind, y_wind, z_wind, 'r', 'LineWidth', 2)
hold on
plot3(x_nowind, y_nowind, z_nowind, 'b', 'LineWidth', 2)

grid on
xlabel('X (East-West)')
ylabel('Y (North-South)')
zlabel('Height')
title('Projectile Motion With and Without Wind')
legend('With Wind', 'Without Wind')

disp('Time of Flight:')
disp(T)

disp('Landing position with wind:')
disp([x_wind(end), y_wind(end), z_wind(end)])

disp('Landing position without wind:')
disp([x_nowind(end), y_nowind(end), z_nowind(end)])

