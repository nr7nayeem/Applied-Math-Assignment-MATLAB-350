clc;
clear;
syms x;
a = sqrt(1.71);
L = pi;
f = 10;
% Calculate cn
for n = 1:10
    c(n) = double(2/L * int(f*sin(n*pi*x/L),x,0,L));
    fprintf("%d  %f\n",n,c(n));
end

% x and t
x = linspace(0,pi,100);
t = linspace(0,10,100);

[X,T] = meshgrid(x,t);

% Plot individual terms
figure(1);

for n = 1:10
    term = c(n).*sin(n*pi.*X/L) ...
        .* exp(-a^2*n^2*pi^2.*T/L^2);

    surf(X,T,term);
    hold on;
end
xlabel('x');
ylabel('t');
zlabel('Temperature');
title('Individual Terms');
grid on;

% Total temperature
u = zeros(size(X));

for n = 1:10
    u = u + c(n).*sin(n*pi.*X/L) ...
        .* exp(-a^2*n^2*pi^2.*T/L^2);
end

% Plot total solution
figure(2);
surf(X,T,u);
xlabel('x');
ylabel('t');
zlabel('Temperature u(x,t)');
title('Total Temperature Distribution');
grid on;
t = linspace(0,1,100);
x=pi/2;
u = zeros(size(t));
for n = 1:10
    u = u + c(n).*sin(n*pi.*x/L) ...
        .* exp(-a^2*n^2*pi^2.*t/L^2);
end
% Plot total solution
figure(3);
plot(t,u);
xlabel('t');
ylabel('Temperature u(x,t)');
title('Total Temperature Distribution');
grid on;
